<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>DSBCCL — Websites & Apps, Built Right</title>
<meta name="description" content="DSBCCL builds websites and apps for small businesses. Simple plans, real support, work you can track." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  /* ============================================================
     COLOR / TYPE TOKENS
     Change these once and the whole site updates.
  ============================================================ */
  :root{
    --paper:#EFEDE6;
    --paper-raised:#F8F7F3;
    --ink:#16233A;
    --ink-soft:#3E4C63;
    --line:#C9C3B4;
    --blue:#2F6F9E;
    --blue-deep:#1D4A6E;
    --signal:#D9A441;
    --success:#3B7A57;
    --danger:#B4472F;
    --radius:2px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Space Grotesk',sans-serif;
    color:var(--ink);
    margin:0;
    letter-spacing:-0.01em;
  }
  .mono{font-family:'IBM Plex Mono',monospace;}
  a{color:inherit;}
  img{max-width:100%;display:block;}
  button{font-family:inherit;cursor:pointer;}
  :focus-visible{outline:2px solid var(--blue);outline-offset:2px;}
  @media (prefers-reduced-motion: reduce){*{animation:none !important;transition:none !important;}}

  .wrap{max-width:1080px;margin:0 auto;padding:0 24px;}

  /* ---------------- Nav ---------------- */
  header.site{
    position:sticky;top:0;z-index:50;
    background:rgba(239,237,230,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  .navbar{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;max-width:1080px;margin:0 auto;}
  .logo{display:flex;align-items:center;gap:10px;font-family:'Space Grotesk';font-weight:700;font-size:1.15rem;}
  .logo-mark{width:28px;height:28px;flex:none;}
  .navlinks{display:flex;gap:28px;align-items:center;font-size:0.95rem;}
  .navlinks a{text-decoration:none;color:var(--ink-soft);}
  .navlinks a:hover{color:var(--ink);}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:10px 18px;border-radius:var(--radius);border:1.5px solid var(--ink);
    background:var(--ink);color:var(--paper);font-weight:600;font-size:0.92rem;
    transition:transform .15s ease;
  }
  .btn:hover{transform:translateY(-1px);}
  .btn.outline{background:transparent;color:var(--ink);}
  .btn.small{padding:7px 14px;font-size:0.85rem;}

  /* Corner-bracket card, an engineering spec-sheet motif */
  .spec-card{
    position:relative;background:var(--paper-raised);
    border:1px solid var(--line);padding:28px;
  }
  .spec-card::before,.spec-card::after{
    content:"";position:absolute;width:14px;height:14px;
    border-top:2px solid var(--blue);border-left:2px solid var(--blue);
    top:-1px;left:-1px;
  }
  .spec-card::after{
    top:auto;left:auto;bottom:-1px;right:-1px;
    border-top:none;border-left:none;
    border-bottom:2px solid var(--blue);border-right:2px solid var(--blue);
  }

  /* ---------------- Hero ---------------- */
  .hero{padding:88px 0 64px;}
  .hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:center;}
  .hero h1{font-size:clamp(2.1rem,4.4vw,3.4rem);line-height:1.08;font-weight:700;}
  .hero p.lede{font-size:1.15rem;color:var(--ink-soft);max-width:46ch;margin-top:18px;}
  .hero-ctas{display:flex;gap:14px;margin-top:32px;flex-wrap:wrap;}
  .hero-visual{width:100%;}
  .founders-line{margin-top:28px;font-size:0.85rem;color:var(--ink-soft);}
  .founders-line .mono{color:var(--blue-deep);}

  section{padding:72px 0;border-top:1px solid var(--line);}
  .section-head{display:flex;align-items:baseline;gap:14px;margin-bottom:40px;}
  .section-head .ruler{flex:none;width:34px;height:2px;background:var(--blue);}
  .section-head h2{font-size:1.7rem;}

  /* ---------------- About / dynamic sections ---------------- */
  #sectionsList{display:grid;gap:28px;}
  .about-block{display:grid;grid-template-columns:120px 1fr;gap:20px;}
  .about-block .idx{font-family:'IBM Plex Mono';color:var(--blue);font-size:0.85rem;padding-top:4px;}
  .about-block h3{font-size:1.15rem;margin-bottom:8px;}
  .about-block p{color:var(--ink-soft);margin:0;}
  @media (max-width:640px){.about-block{grid-template-columns:1fr;} .about-block .idx{display:none;}}

  /* ---------------- Plans ---------------- */
  .plans-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  @media (max-width:860px){.plans-grid{grid-template-columns:1fr;}}
  .plan{display:flex;flex-direction:column;gap:14px;}
  .plan.highlight{border-color:var(--blue);}
  .plan.highlight::before,.plan.highlight::after{border-color:var(--signal);}
  .plan-name{font-family:'Space Grotesk';font-weight:600;font-size:1.05rem;}
  .plan-price{font-family:'Space Grotesk';font-size:2.1rem;font-weight:700;}
  .plan-price span{font-size:0.95rem;color:var(--ink-soft);font-family:'Inter';font-weight:500;}
  .plan-tagline{color:var(--ink-soft);font-size:0.9rem;min-height:2.4em;}
  .plan ul{list-style:none;padding:0;margin:0;display:grid;gap:8px;font-size:0.92rem;flex:1;}
  .plan ul li{display:flex;gap:8px;color:var(--ink-soft);}
  .plan ul li::before{content:"—";color:var(--blue);flex:none;}
  .plan .btn{justify-content:center;margin-top:6px;}

  /* ---------------- Order form ---------------- */
  .order-layout{display:grid;grid-template-columns:1fr;gap:28px;max-width:640px;}
  .field{display:flex;flex-direction:column;gap:6px;}
  .field label{font-size:0.85rem;color:var(--ink-soft);font-weight:600;}
  .field input,.field select,.field textarea{
    font-family:inherit;font-size:0.98rem;padding:12px 14px;
    border:1.5px solid var(--line);background:#fff;color:var(--ink);
    border-radius:var(--radius);
  }
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--blue);outline:none;}
  .field textarea{min-height:110px;resize:vertical;}

  /* ---------------- Track status ---------------- */
  .lookup-row{display:flex;gap:10px;max-width:420px;margin-bottom:32px;flex-wrap:wrap;}
  .lookup-row input{flex:1;min-width:200px;}
  .order-row{
    display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;
    padding:16px 0;border-bottom:1px solid var(--line);
  }
  .order-row:last-child{border-bottom:none;}
  .order-id{font-family:'IBM Plex Mono';font-size:0.78rem;color:var(--ink-soft);}
  .order-service{font-weight:600;}
  .order-detail{color:var(--ink-soft);font-size:0.9rem;margin-top:2px;}
  .pill{
    font-family:'IBM Plex Mono';font-size:0.75rem;padding:5px 12px;border-radius:20px;
    white-space:nowrap;border:1px solid currentColor;
  }
  .pill.received{color:var(--ink-soft);}
  .pill.reviewing{color:var(--blue-deep);}
  .pill.in-progress{color:var(--signal);}
  .pill.completed{color:var(--success);}
  .pill.cancelled{color:var(--danger);}
  .empty-state{padding:36px 0;text-align:center;color:var(--ink-soft);}

  footer{padding:48px 0 60px;border-top:1px solid var(--line);}
  .footer-grid{display:flex;justify-content:space-between;flex-wrap:wrap;gap:24px;font-size:0.9rem;color:var(--ink-soft);}
  .footer-grid .mono{color:var(--ink);}

  .toast{
    position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);
    background:var(--ink);color:var(--paper);padding:14px 22px;border-radius:var(--radius);
    font-size:0.9rem;opacity:0;transition:opacity .25s ease, transform .25s ease;pointer-events:none;z-index:100;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
</style>
</head>
<body>

<!-- ============================================================
     NAV
     No sign-in here on purpose — customers place orders and
     look up status just by typing their phone number.
============================================================ -->
<header class="site">
  <div class="navbar">
    <div class="logo">
      <svg class="logo-mark" viewBox="0 0 28 28" fill="none">
        <rect x="1" y="1" width="26" height="26" stroke="#16233A" stroke-width="1.5"/>
        <path d="M7 20V8h5.5a5 5 0 0 1 0 10H9" stroke="#2F6F9E" stroke-width="1.8" stroke-linecap="square"/>
        <path d="M18 8v12" stroke="#D9A441" stroke-width="1.8" stroke-linecap="square"/>
      </svg>
      DSBCCL
    </div>
    <nav class="navlinks">
      <a href="#about">About</a>
      <a href="#plans">Plans</a>
      <a href="#order">Order</a>
      <a href="#track">Track</a>
    </nav>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero" style="border-top:none;">
    <div class="wrap hero-grid">
      <div>
        <h1>We build the websites and apps your business actually runs on.</h1>
        <p class="lede">DSBCCL is a small engineering team that designs, builds and maintains web and mobile software — plans that fit a small budget, and a status tracker so you're never left wondering.</p>
        <div class="hero-ctas">
          <a href="#order" class="btn">Start an order</a>
          <a href="#plans" class="btn outline">See plans</a>
        </div>
        <p class="founders-line">Founded by <span class="mono">Abhinav Kumar</span> &amp; <span class="mono">Purushottam Srivastava</span></p>
      </div>
      <div class="hero-visual">
        <svg viewBox="0 0 360 300" width="100%">
          <rect x="0.5" y="0.5" width="359" height="299" fill="none" stroke="#C9C3B4"/>
          <g stroke="#2F6F9E" stroke-width="1.5" fill="none">
            <rect x="40" y="40" width="90" height="60"/>
            <rect x="180" y="40" width="140" height="60"/>
            <rect x="40" y="130" width="140" height="60"/>
            <rect x="220" y="130" width="100" height="120"/>
            <rect x="40" y="220" width="140" height="40"/>
          </g>
          <g stroke="#D9A441" stroke-width="1.5">
            <line x1="130" y1="70" x2="180" y2="70"/>
            <line x1="180" y1="100" x2="180" y2="130"/>
            <line x1="180" y1="160" x2="220" y2="160"/>
            <line x1="110" y1="190" x2="110" y2="220"/>
          </g>
          <g fill="#16233A" font-family="IBM Plex Mono" font-size="10">
            <text x="46" y="55">UI</text>
            <text x="186" y="55">API</text>
            <text x="46" y="145">DB</text>
            <text x="226" y="145">AUTH</text>
            <text x="46" y="235">APP</text>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- ABOUT (content managed from admin.html) -->
  <section id="about">
    <div class="wrap">
      <div class="section-head"><span class="ruler"></span><h2>About us</h2></div>
      <div id="sectionsList"><p class="empty-state mono">Loading…</p></div>
    </div>
  </section>

  <!-- PLANS (content managed from admin.html) -->
  <section id="plans">
    <div class="wrap">
      <div class="section-head"><span class="ruler"></span><h2>Plans</h2></div>
      <div class="plans-grid" id="plansGrid"><p class="empty-state mono">Loading…</p></div>
    </div>
  </section>

  <!-- ORDER FORM — no login. Name + phone identify the order. -->
  <section id="order">
    <div class="wrap">
      <div class="section-head"><span class="ruler"></span><h2>Start an order</h2></div>
      <form class="spec-card order-layout" id="orderForm">
        <div class="field">
          <label for="oName">Your name</label>
          <input id="oName" required>
        </div>
        <div class="field">
          <label for="oPhone">Phone number</label>
          <input id="oPhone" type="tel" required placeholder="10-digit mobile number">
        </div>
        <div class="field">
          <label for="oService">What do you need?</label>
          <select id="oService" required>
            <option value="">Select one</option>
            <option>Website</option>
            <option>Mobile app</option>
            <option>Website + app</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="planSelect">Plan you're interested in</label>
          <select id="planSelect"><option value="">Not sure yet</option></select>
        </div>
        <div class="field">
          <label for="oDetails">Tell us about the project</label>
          <textarea id="oDetails" required placeholder="What's it for, who's it for, any deadline?"></textarea>
        </div>
        <button class="btn" type="submit">Submit order</button>
      </form>
    </div>
  </section>

  <!-- TRACK STATUS — look up by the phone number used when ordering -->
  <section id="track">
    <div class="wrap">
      <div class="section-head"><span class="ruler"></span><h2>Track your orders</h2></div>
      <p style="color:var(--ink-soft);margin:-20px 0 20px;max-width:50ch;">Enter the same phone number you used when placing your order.</p>
      <div class="lookup-row">
        <input id="lookupPhone" type="tel" placeholder="10-digit mobile number">
        <button class="btn" id="lookupBtn">Look up</button>
      </div>
      <div id="trackArea"><p class="empty-state">No lookup yet.</p></div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap footer-grid">
    <div><span class="mono">DSBCCL</span> — Websites &amp; apps, engineered simply.</div>
    <div id="footerContact">Abhinav Kumar &amp; Purushottam Srivastava</div>
  </div>
</footer>

<div class="toast" id="toast"></div>

<!-- Firebase -->
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script>
const firebaseConfig = {
  apiKey:            "AIzaSyBDwj4-3S3onrvxaQ_7U5RKpUpwmuGw2cQ",
  authDomain:        "dsbccl.firebaseapp.com",
  databaseURL:       "https://dsbccl-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId:         "dsbccl",
  storageBucket:     "dsbccl.firebasestorage.app",
  messagingSenderId: "205930025727",
  appId:             "1:205930025727:web:d2dddbe1018cdb9857f2ca",
  measurementId:     "G-XZZL8EH410"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();

// Sign in anonymously in the background so Firestore write rules
// (which require request.auth != null) are satisfied. The visitor
// never sees this — no button, no prompt.
auth.signInAnonymously().catch(err=> console.error('Anonymous sign-in failed:', err));

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2600);
}
function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

/* ---------- Site content (hero/footer, editable in admin) ---------- */
db.collection('site').doc('home').onSnapshot(snap=>{
  if(!snap.exists) return;
  const d = snap.data();
  if(d.heroTitle) document.querySelector('.hero h1').textContent = d.heroTitle;
  if(d.heroSubtitle) document.querySelector('.hero .lede').textContent = d.heroSubtitle;
  if(d.footerText) document.getElementById('footerContact').textContent = d.footerText;
}, err=> console.error(err));

/* ---------- Dynamic About sections ---------- */
db.collection('sections').orderBy('order','asc').onSnapshot(snap=>{
  const el = document.getElementById('sectionsList');
  if(snap.empty){ el.innerHTML = '<p class="empty-state">Content coming soon.</p>'; return; }
  el.innerHTML = '';
  let i = 1;
  snap.forEach(doc=>{
    const d = doc.data();
    const idx = String(i++).padStart(2,'0');
    el.insertAdjacentHTML('beforeend', `
      <div class="about-block">
        <div class="idx mono">${idx}</div>
        <div><h3>${escapeHtml(d.title||'')}</h3><p>${escapeHtml(d.body||'')}</p></div>
      </div>`);
  });
}, err=> console.error(err));

/* ---------- Dynamic Plans ---------- */
db.collection('plans').orderBy('order','asc').onSnapshot(snap=>{
  const grid = document.getElementById('plansGrid');
  const select = document.getElementById('planSelect');
  if(snap.empty){ grid.innerHTML = '<p class="empty-state">Plans coming soon.</p>'; return; }
  grid.innerHTML = '';
  select.innerHTML = '<option value="">Not sure yet</option>';
  snap.forEach(doc=>{
    const d = doc.data();
    const features = (d.features||[]).map(f=>`<li>${escapeHtml(f)}</li>`).join('');
    grid.insertAdjacentHTML('beforeend', `
      <div class="spec-card plan ${d.highlight?'highlight':''}">
        <div class="plan-name">${escapeHtml(d.name||'')}</div>
        <div class="plan-price">₹${d.price}<span>/${escapeHtml(d.period||'')}</span></div>
        <div class="plan-tagline">${escapeHtml(d.tagline||'')}</div>
        <ul>${features}</ul>
        <a href="#order" class="btn ${d.highlight?'':'outline'}" onclick="preselectPlan('${escapeHtml(d.name||'')}')">Choose this plan</a>
      </div>`);
    select.insertAdjacentHTML('beforeend', `<option value="${escapeHtml(d.name||'')}">${escapeHtml(d.name||'')}</option>`);
  });
}, err=> console.error(err));

function preselectPlan(name){
  setTimeout(()=>{
    const sel = document.getElementById('planSelect');
    if(sel) sel.value = name;
  }, 50);
}

/* ---------- Order form ---------- */
document.getElementById('orderForm').addEventListener('submit', function(e){
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; btn.textContent = 'Submitting…';
  db.collection('orders').add({
    uid: auth.currentUser ? auth.currentUser.uid : null,
    name: document.getElementById('oName').value.trim(),
    phone: document.getElementById('oPhone').value.trim(),
    service: document.getElementById('oService').value,
    plan: document.getElementById('planSelect').value,
    details: document.getElementById('oDetails').value.trim(),
    status: 'received',
    createdAt: firebase.firestore.FieldValue.serverTimestamp()
  }).then(()=>{
    toast('Order submitted — look it up below with the same phone number.');
    document.getElementById('lookupPhone').value = document.getElementById('oPhone').value.trim();
    e.target.reset();
    document.getElementById('track').scrollIntoView({behavior:'smooth'});
    runLookup();
  }).catch(err=>{
    toast('Could not submit: ' + err.message);
  }).finally(()=>{
    btn.disabled = false; btn.textContent = 'Submit order';
  });
});

/* ---------- Track status by phone lookup ---------- */
let unsubscribeOrders = null;
function runLookup(){
  const phone = document.getElementById('lookupPhone').value.trim();
  const el = document.getElementById('trackArea');
  if(unsubscribeOrders){ unsubscribeOrders(); unsubscribeOrders = null; }
  if(!phone){ el.innerHTML = '<p class="empty-state">Enter a phone number above.</p>'; return; }
  el.innerHTML = '<p class="empty-state mono">Looking up…</p>';
  unsubscribeOrders = db.collection('orders').where('phone','==',phone)
    .onSnapshot(snap=>{
      if(snap.empty){ el.innerHTML = '<p class="empty-state">No orders found for that number.</p>'; return; }
      const rows = [];
      snap.forEach(doc=>{
        const d = doc.data();
        const ts = d.createdAt && d.createdAt.toDate ? d.createdAt.toDate().toLocaleDateString() : '—';
        const statusLabel = (d.status||'received').replace('-',' ');
        rows.push({ts_raw: d.createdAt? d.createdAt.toMillis(): 0, html:`
        <div class="spec-card order-row">
          <div>
            <div class="order-service">${escapeHtml(d.service||'Request')}</div>
            <div class="order-detail">${escapeHtml((d.details||'').slice(0,120))}${(d.details||'').length>120?'…':''}</div>
            <div class="order-id">#${doc.id.slice(0,8)} · ${ts}</div>
          </div>
          <span class="pill ${d.status||'received'}">${escapeHtml(statusLabel)}</span>
        </div>`});
      });
      rows.sort((a,b)=> b.ts_raw - a.ts_raw);
      el.innerHTML = rows.map(r=>r.html).join('');
    }, err=>{
      el.innerHTML = '<p class="empty-state">Could not load orders.</p>';
      console.error(err);
    });
}
document.getElementById('lookupBtn').onclick = runLookup;
document.getElementById('lookupPhone').addEventListener('keydown', e=>{
  if(e.key === 'Enter'){ e.preventDefault(); runLookup(); }
});
</script>
</body>
</html>
